<%- include('partials/header') %>

<div class="row mb-4">
  <div class="col text-center">
    <h2 class="fw-bold text-secondary"><i class="bi bi-bar-chart-line-fill text-warning me-2"></i>Visual Cashflow Analytics</h2>
    <p class="text-muted">Analyze your income vs expenses side-by-side</p>
  </div>
</div>

<div class="row justify-content-center">
  <% if (expenses.length === 0) { %>
    <div class="col-md-6 text-center py-5">
      <p class="text-muted">No data available to generate charts. Add some income or expenses first!</p>
    </div>
  <% } else { %>
    <!-- Income Chart Column -->
    <div class="col-md-5 mb-4">
      <div class="card shadow p-4 bg-white rounded-4 border-0 h-100">
        <h5 class="text-center mb-3 fw-bold text-success">Income Sources</h5>
        <div class="d-flex align-items-center justify-content-center" style="position: relative; min-height: 320px;">
          <canvas id="incomeChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Expense Chart Column -->
    <div class="col-md-5 mb-4">
      <div class="card shadow p-4 bg-white rounded-4 border-0 h-100">
        <h5 class="text-center mb-3 fw-bold text-danger">Expense Breakdown</h5>
        <div class="d-flex align-items-center justify-content-center" style="position: relative; min-height: 320px;">
          <canvas id="expenseChart"></canvas>
        </div>
      </div>
    </div>
  <% } %>
</div>

<% if (expenses.length > 0) { %>
<script>
  // Backend se data parse karna
  const rawData = '<%= JSON.stringify(expenses) %>';
  const transactions = rawData ? JSON.parse(rawData.replace(/&#34;/g, '"')) : [];
  
  const incomeTotals = {};
  const expenseTotals = {};

  transactions.forEach(item => {
    const type = item.type ? item.type.toLowerCase() : '';
    if (type === 'income') {
      incomeTotals[item.category] = (incomeTotals[item.category] || 0) + Number(item.amount);
    } else {
      expenseTotals[item.category] = (expenseTotals[item.category] || 0) + Number(item.amount);
    }
  });

  // Dashboard wala Same Dynamic Golden Ratio Hue Generator (No repeats, vibrant colors)
  function getDynamicCategoryColors(categories) {
    // Basic mapped preset colors for popular defaults
    const categoryColorMap = {
      'Food': '#f97316',          // Vibrant Orange
      'Transport': '#6366f1',     // Indigo
      'Bills': '#ef4444',         // Red
      'Entertainment': '#10b981', // Green
      'Shopping': '#f59e0b',      // Amber
      'Lifestyle': '#8b5cf6',     // Purple
      'Investment': '#ec4899',    // Pink
      'Salary': '#10b981',       // Green
      'Other': '#3b82f6'          // Blue
    };

    return categories.map((cat, index) => {
      if (categoryColorMap[cat]) {
        return categoryColorMap[cat];
      }
      // Golden ratio hue angle calculation for endless distinct colorful shades
      const hue = (index * 137.508) % 360; 
      return `hsl(${hue}, 80%, 50%)`;
    });
  }

  // Common options for crisp, round charts
  const commonChartOptions = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: {
        position: 'bottom',
        labels: {
          padding: 15,
          usePointStyle: true,
          boxWidth: 8
        }
      }
    }
  };

  // 1. Income Chart
  const incomeCategories = Object.keys(incomeTotals);
  const incCtx = document.getElementById('incomeChart');
  if (incCtx) {
    new Chart(incCtx.getContext('2d'), {
      type: 'pie',
      data: {
        labels: incomeCategories.length > 0 ? incomeCategories : ['No Income'],
        datasets: [{
          data: incomeCategories.length > 0 ? Object.values(incomeTotals) : [1],
          backgroundColor: incomeCategories.length > 0 ? getDynamicCategoryColors(incomeCategories) : ['#cbd5e1'],
          borderWidth: 2,
          borderColor: '#ffffff'
        }]
      },
      options: commonChartOptions
    });
  }

  // 2. Expense Chart
  const expenseCategories = Object.keys(expenseTotals);
  const expCtx = document.getElementById('expenseChart');
  if (expCtx) {
    new Chart(expCtx.getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: expenseCategories.length > 0 ? expenseCategories : ['No Expenses'],
        datasets: [{
          data: expenseCategories.length > 0 ? Object.values(expenseTotals) : [1],
          backgroundColor: expenseCategories.length > 0 ? getDynamicCategoryColors(expenseCategories) : ['#cbd5e1'],
          borderWidth: 2,
          borderColor: '#ffffff'
        }]
      },
      options: commonChartOptions
    });
  }
</script>
<% } %>

<%- include('partials/footer') %>