<%- include('partials/header') %>

<div class="row mb-4">
  <div class="col text-center">
    <h2 class="fw-bold text-secondary"><i class="bi bi-bar-chart-line-fill text-warning me-2"></i>Visual Cashflow Analytics</h2>
    <p class="text-muted">Analyze your income vs expenses side-by-side</p>
  </div>
</div>

<div class="row justify-content-center">
  <% if (expenses.length === 0) { %>
    <div class="col-md-6 text-center py-5">
      <p class="text-muted">No data available to generate charts. Add some income or expenses first!</p>
    </div>
  <% } else { %>
    <!-- Income Chart Column -->
    <div class="col-md-5 mb-4">
      <div class="card shadow p-3 bg-white rounded border-0">
        <h5 class="text-center mb-3 fw-bold text-success">Income Sources</h5>
        <div style="position: relative; height:280px; width:100%">
          <canvas id="incomeChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Expense Chart Column -->
    <div class="col-md-5 mb-4">
      <div class="card shadow p-3 bg-white rounded border-0">
        <h5 class="text-center mb-3 fw-bold text-danger">Expense Breakdown</h5>
        <div style="position: relative; height:280px; width:100%">
          <canvas id="expenseChart"></canvas>
        </div>
      </div>
    </div>
  <% } %>
</div>

<% if (expenses.length > 0) { %>
<script>
  // Backend se data parse karna
  const rawData = '<%= JSON.stringify(expenses) %>';
  const transactions = rawData ? JSON.parse(rawData.replace(/&#34;/g, '"')) : [];
  
  const incomeTotals = {};
  const expenseTotals = {};

  transactions.forEach(item => {
    if (item.type === 'Income') {
      incomeTotals[item.category] = (incomeTotals[item.category] || 0) + item.amount;
    } else {
      expenseTotals[item.category] = (expenseTotals[item.category] || 0) + item.amount;
    }
  });

  // Unique Color Mapping Function (Har Category ko hamesha distinct vibrant color milega)
  const categoryColorMap = {
    'Salary': '#10b981',       // Emerald Green
    'Pocket Money': '#f59e0b', // Amber
    'Business': '#06b6d4',     // Cyan
    'Profit': '#8b5cf6',       // Purple
    'Funding': '#3b82f6',      // Blue
    'Remittance': '#ec4899',   // Pink
    'Food': '#f97316',         // Orange
    'Transport': '#6366f1',    // Indigo
    'Bills': '#ef4444',        // Red
    'Entertainment': '#e11d48',// Rose Red
    'Lifestyle': '#64748b',    // Slate
    'Investment': '#14b8a6',   // Teal
    'Other': '#a855f7'         // Violet
  };

  // Dynamic Array Generator fallback for unknown categories
  function getCategoryColors(categories) {
    const fallbackPalette = ['#10b981', '#3b82f6', '#f59e0b', '#8b5cf6', '#ec4899', '#ef4444', '#06b6d4', '#f97316', '#6366f1', '#14b8a6', '#64748b'];
    return categories.map((cat, index) => categoryColorMap[cat] || fallbackPalette[index % fallbackPalette.length]);
  }

  // 1. Income Chart
  const incomeCategories = Object.keys(incomeTotals);
  const incCtx = document.getElementById('incomeChart').getContext('2d');
  new Chart(incCtx, {
    type: 'pie',
    data: {
      labels: incomeCategories,
      datasets: [{
        data: Object.values(incomeTotals),
        backgroundColor: getCategoryColors(incomeCategories),
        borderWidth: 2,
        borderColor: '#ffffff'
      }]
    },
    options: { 
      responsive: true, 
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'bottom' }
      }
    }
  });

  // 2. Expense Chart
  const expenseCategories = Object.keys(expenseTotals);
  const expCtx = document.getElementById('expenseChart').getContext('2d');
  new Chart(expCtx, {
    type: 'doughnut',
    data: {
      labels: expenseCategories,
      datasets: [{
        data: Object.values(expenseTotals),
        backgroundColor: getCategoryColors(expenseCategories),
        borderWidth: 2,
        borderColor: '#ffffff'
      }]
    },
    options: { 
      responsive: true, 
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'bottom' }
      }
    }
  });
</script>
<% } %>

<%- include('partials/footer') %>