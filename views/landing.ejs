<%- include('partials/header') %>

<!-- Hero Section -->
<div class="d-flex gap-3">
  <% if (user) { %>
    <a href="/dashboard" class="btn btn-warning btn-lg px-4 fw-semibold shadow-sm"><i class="bi bi-speedometer2 me-2"></i>Go to Dashboard</a>
    <a href="/profile" class="btn btn-outline-dark btn-lg px-4"><i class="bi bi-person-circle me-2"></i>My Profile</a>
  <% } else { %>
    <a href="/signup" class="btn btn-warning btn-lg px-4 fw-semibold shadow-sm"><i class="bi bi-rocket-takeoff me-2"></i>Get Started Free</a>
    <a href="/login" class="btn btn-outline-dark btn-lg px-4"><i class="bi bi-box-arrow-in-right me-2"></i>Sign In</a>
  <% } %>
</div>

<!-- Features Section -->
<div class="row g-4 py-5 text-center">
  <div class="col-md-4">
    <div class="card h-100 p-4 border-0 shadow-sm">
      <div class="fs-1 text-success mb-3"><i class="bi bi-cash-stack"></i></div>
      <h5 class="fw-bold">Dynamic Categorization</h5>
      <p class="text-muted small">Categorize income vs expense sources dynamically with tailored input forms.</p>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100 p-4 border-0 shadow-sm">
      <div class="fs-1 text-primary mb-3"><i class="bi bi-pie-chart-fill"></i></div>
      <h5 class="fw-bold">Visual Analytics</h5>
      <p class="text-muted small">Analyze income & expense breakdowns using clear Chart.js Pie and Doughnut visualizers.</p>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100 p-4 border-0 shadow-sm">
      <div class="fs-1 text-warning mb-3"><i class="bi bi-shield-lock-fill"></i></div>
      <h5 class="fw-bold">Secure Data</h5>
      <p class="text-muted small">Encrypted user accounts and session authorization keep your private records safe.</p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>