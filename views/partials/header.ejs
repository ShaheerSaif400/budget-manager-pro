<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Budget Manager Pro</title>

  <!-- 1. PROFESSIONAL SVG FAVICON -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%230f172a'/><path d='M30 35 C30 25, 70 25, 70 35 L70 70 C70 75, 30 75, 30 70 Z' fill='none' stroke='%23f59e0b' stroke-width='8'/><circle cx='50' cy='52' r='10' fill='%2310b981'/></svg>">

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    body { background-color: #f8f9fa; display: flex; flex-direction: column; min-height: 100vh; }
    main { flex: 1; }
    
    /* Sleek Branding Style */
    .brand-container {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
    }
    .brand-badge {
      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
      border: 1px solid rgba(245, 158, 11, 0.4);
      padding: 6px 10px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
    .brand-title {
      font-weight: 800;
      letter-spacing: -0.3px;
      color: #ffffff;
      font-size: 1.2rem;
    }
    .brand-title span {
      color: #f59e0b;
    }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-3">
  <div class="container">

    <!-- 2. MODERN VECTOR BRAND LOGO -->
    <a class="brand-container" href="/">
      <div class="brand-badge">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="24" height="24" rx="6" fill="#1E293B"/>
          <path d="M5 8.5C5 6.567 6.567 5 8.5 5H15.5C17.433 5 19 6.567 19 8.5V15.5C19 17.433 17.433 19 15.5 19H8.5C6.567 19 5 17.433 5 15.5V8.5Z" stroke="#F59E0B" stroke-width="1.5"/>
          <path d="M12 8V16M9 10.5L12 8L15 10.5" stroke="#10B981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <span class="brand-title">Budget<span>Pro</span></span>
    </a>
    
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto align-items-center">
        <li class="nav-item">
          <a class="nav-link" href="/"><i class="bi bi-house-door me-1"></i> Home</a>
        </li>

        <% if (user) { %>
          <li class="nav-item">
            <a class="nav-link" href="/dashboard"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/analytics"><i class="bi bi-pie-chart-fill me-1"></i> Analytics</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/blogs"><i class="bi bi-journal-text me-1"></i> Blog</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/profile"><i class="bi bi-person-circle me-1"></i> <%= user.name %></a>
          </li>
          <li class="nav-item ms-2">
            <a class="btn btn-outline-danger btn-sm px-3" href="/logout"><i class="bi bi-box-arrow-right me-1"></i> Logout</a>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="nav-link" href="/blogs"><i class="bi bi-journal-text me-1"></i> Blog</a>
          </li>
          <li class="nav-item ms-2">
            <a class="btn btn-outline-light btn-sm px-3" href="/login">Login</a>
          </li>
          <li class="nav-item ms-2">
            <a class="btn btn-warning btn-sm px-3 fw-semibold" href="/signup">Get Started</a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<main class="py-4">
<div class="container">