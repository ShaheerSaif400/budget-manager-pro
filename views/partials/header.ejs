<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3">
  <link rel="alternate icon" href="/favicon.svg?v=3">
  
  <title>Budget Manager Pro</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    body { background-color: #f8f9fa; display: flex; flex-direction: column; min-height: 100vh; }
    main { flex: 1; }
    
    /* Logo styling without drop-shadow/glow */
    .brand-logo-img {
      height: 44px;
      width: auto;
      object-fit: contain;
    }

    .nav-link {
      color: rgba(255, 255, 255, 0.8) !important;
      font-weight: 500;
      transition: all 0.2s ease;
    }
    .nav-link:hover {
      color: #10b981 !important;
      transform: translateY(-1px);
    }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-2 border-bottom border-dark">
  <div class="container-xl px-3 px-lg-4">

    <!-- Navbar Brand / Logo -->
    <a class="navbar-brand d-flex align-items-center py-0" href="/">
      <img src="/logo.svg" alt="BudgetPro" class="brand-logo-img d-inline-block">
    </a>
    
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto align-items-center gap-lg-2 my-2 my-lg-0">
        <li class="nav-item">
          <a class="nav-link px-3" href="/"><i class="bi bi-house-door me-1"></i> Home</a>
        </li>

        <% if (user) { %>
          <li class="nav-item">
            <a class="nav-link px-3" href="/dashboard"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
          </li>
          <li class="nav-item">
            <a class="nav-link px-3" href="/analytics"><i class="bi bi-pie-chart-fill me-1"></i> Analytics</a>
          </li>
          <li class="nav-item">
            <a class="nav-link px-3" href="/blogs"><i class="bi bi-journal-text me-1"></i> Blog</a>
          </li>
          <li class="nav-item ms-lg-2">
            <a class="nav-link px-3 fw-semibold text-white bg-secondary bg-opacity-25 rounded-pill border border-secondary border-opacity-50" href="/profile">
              <i class="bi bi-person-circle text-success me-1"></i> <%= user.name %>
            </a>
          </li>
          <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
            <a class="btn btn-outline-danger btn-sm px-3 rounded-pill" href="/logout"><i class="bi bi-box-arrow-right me-1"></i> Logout</a>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="nav-link px-3" href="/blogs"><i class="bi bi-journal-text me-1"></i> Blog</a>
          </li>
          <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
            <a class="btn btn-outline-light btn-sm px-3 rounded-pill" href="/login">Login</a>
          </li>
          <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
            <a class="btn btn-success btn-sm px-3 fw-semibold rounded-pill" style="background-color: #10b981; border: none;" href="/signup">Get Started</a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<main class="py-4">
<div class="container-xl px-3 px-lg-4">