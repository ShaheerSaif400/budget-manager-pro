<%- include('partials/header') %>

<!-- Chart.js CDN for Interactive Graphs -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container py-4">

  <!-- TOP BAR: User Welcome & Action Controls -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <span class="badge bg-soft-success text-success px-3 py-2 rounded-pill fw-semibold mb-2" style="background-color: #d1fae5;">
        <i class="bi bi-circle-fill me-1 small"></i> Live Overview
      </span>
      <h2 class="fw-bold text-dark mb-0">Welcome back, <%= user ? user.name || 'User' : 'User' %>! </h2>
      <p class="text-muted small mb-0">Here's a detailed breakdown of your financial health.</p>
    </div>
    
    <div class="d-flex gap-2">
      <button type="button" class="btn btn-success fw-semibold px-4 py-2 shadow-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#addTransactionModal" style="border-radius: 12px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none;">
        <i class="bi bi-plus-lg fs-5"></i> Add Transaction
      </button>
    </div>
  </div>

  <!-- METRIC STAT CARDS -->
  <div class="row g-4 mb-4">
    <!-- Total Income Card -->
    <div class="col-lg-4 col-md-6">
      <div class="card border-0 shadow-sm p-3 h-100 position-relative overflow-hidden" style="border-radius: 20px; background: linear-gradient(135deg, #059669 0%, #10b981 100%); color: white;">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <span class="text-white-50 fw-semibold text-uppercase small tracking-wide">Total Income</span>
          <div class="bg-white bg-opacity-25 rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
            <i class="bi bi-arrow-down-left fs-4"></i>
          </div>
        </div>
        <h2 class="fw-extrabold mb-1">Rs. <%= typeof totalIncome !== 'undefined' ? totalIncome.toLocaleString() : 0 %></h2>
        <div class="d-flex align-items-center text-white-50 small mt-2">
          <i class="bi bi-check-circle-fill text-white me-1"></i> Lifetime total earnings
        </div>
      </div>
    </div>

    <!-- Total Expense Card -->
    <div class="col-lg-4 col-md-6">
      <div class="card border-0 shadow-sm p-3 h-100 position-relative overflow-hidden" style="border-radius: 20px; background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%); color: white;">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <span class="text-white-50 fw-semibold text-uppercase small tracking-wide">Total Spent</span>
          <div class="bg-white bg-opacity-25 rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
            <i class="bi bi-arrow-up-right fs-4"></i>
          </div>
        </div>
        <h2 class="fw-extrabold mb-1">Rs. <%= typeof totalExpense !== 'undefined' ? totalExpense.toLocaleString() : 0 %></h2>
        <div class="d-flex align-items-center text-white-50 small mt-2">
          <i class="bi bi-wallet2 me-1"></i> Lifetime total spending
        </div>
      </div>
    </div>

    <!-- Net Balance Card -->
    <div class="col-lg-4 col-md-12">
      <div class="card border-0 shadow-sm p-3 h-100" style="border-radius: 20px; background-color: #ffffff; border: 1px solid #f1f5f9;">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <span class="text-muted fw-semibold text-uppercase small tracking-wide">Net Savings</span>
          <div class="bg-light rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
            <i class="bi bi-safe fs-4 text-dark"></i>
          </div>
        </div>
        <% const netBalance = (typeof totalIncome !== 'undefined' ? totalIncome : 0) - (typeof totalExpense !== 'undefined' ? totalExpense : 0); %>
        <h2 class="fw-extrabold mb-1 <%= netBalance >= 0 ? 'text-dark' : 'text-danger' %>">
          Rs. <%= netBalance.toLocaleString() %>
        </h2>
        <div class="progress mt-3" style="height: 6px; border-radius: 10px; background-color: #f1f5f9;">
          <% 
            let savingsPercent = totalIncome > 0 ? Math.max(0, Math.min(100, Math.round((netBalance / totalIncome) * 100))) : 0;
          %>
          <div class="progress-bar bg-success" role="progressbar" style="width: <%= savingsPercent %>%; border-radius: 10px;" aria-valuenow="<%= savingsPercent %>" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
        <small class="text-muted mt-2 d-block"><%= savingsPercent %>% of total income saved</small>
      </div>
    </div>
  </div>

  <!-- INTERACTIVE CHARTS SECTION -->
  <div class="row g-4 mb-4">
    <!-- Doughnut Chart: Category Breakdown -->
    <div class="col-lg-5">
      <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 20px; background-color: #ffffff;">
        <h5 class="fw-bold text-dark mb-1">Expenses by Category</h5>
        <p class="text-muted small mb-3">Visual distribution of your spending</p>
        <div class="d-flex align-items-center justify-content-center" style="position: relative; height: 250px;">
          <canvas id="categoryChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Financial Health Overview Bar Chart -->
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 20px; background-color: #ffffff;">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h5 class="fw-bold text-dark mb-1">Income vs Expense Ratio</h5>
            <p class="text-muted small mb-0">Comparison of inflows vs outflows</p>
          </div>
        </div>
        <div style="position: relative; height: 240px;">
          <canvas id="ratioChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Budget Status & Limits Section -->
  <div class="row my-4">
    <div class="col-12">
      <div class="card shadow-sm border-0 rounded-3 p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="fw-bold mb-0">Monthly Category Budgets</h5>
          
          <!-- Button to Trigger Set Budget Modal -->
          <button class="btn btn-sm btn-outline-primary fw-bold" data-bs-toggle="modal" data-bs-target="#setBudgetModal">
            + Set Budget
          </button>
        </div>

        <% if (budgets && budgets.length > 0) { %>
          <div class="row g-3">
            <% budgets.forEach(b => { %>
              <div class="col-md-6 col-lg-4">
                <div class="p-3 border rounded-3 <%= b.isOver ? 'border-danger bg-light-danger' : 'bg-light' %>">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold"><%= b.category %></span>
                    <div>
                      <!-- EDIT BUDGET BUTTON -->
                      <button type="button" class="btn btn-link text-primary p-0 border-0 me-2 text-decoration-none" style="font-size: 0.85rem;" data-bs-toggle="modal" data-bs-target="#editBudgetModal-<%= b._id %>">
                        <i class="bi bi-pencil me-1"></i>Edit
                      </button>
                      <!-- DELETE BUDGET FORM -->
                      <form action="/budget/delete/<%= b._id %>" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this budget limit?');">
                        <button class="btn btn-link text-danger p-0 border-0 text-decoration-none" style="font-size: 0.85rem;">
                          <i class="bi bi-trash me-1"></i>Delete
                        </button>
                      </form>
                    </div>
                  </div>

                  <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>Spent: Rs <%= b.spent.toLocaleString() %></span>
                    <span>Limit: Rs <%= b.monthlyLimit.toLocaleString() %></span>
                  </div>

                  <!-- Progress Bar -->
                  <div class="progress" style="height: 10px;">
                    <div 
                      class="progress-bar <%= b.isOver ? 'bg-danger' : (b.percentage > 75 ? 'bg-warning' : 'bg-success') %>" 
                      role="progressbar" 
                      style="width: <%= b.percentage %>%;">
                    </div>
                  </div>

                  <!-- Over Budget Alert Warning -->
                  <% if (b.isOver) { %>
                    <p class="text-danger small fw-bold mt-2 mb-0">
                      ⚠ Warning: Exceeded by Rs <%= (b.spent - b.monthlyLimit).toLocaleString() %>!
                    </p>
                  <% } %>
                </div>
              </div>

              <!-- EDIT BUDGET MODAL (Individual for each category) -->
              <div class="modal fade" id="editBudgetModal-<%= b._id %>" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                    <form action="/budget/set" method="POST">
                      <div class="modal-header">
                        <h5 class="modal-title fw-bold">Edit Budget limit for <%= b.category %></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body">
                        <input type="hidden" name="category" value="<%= b.category %>">
                        <div class="mb-3">
                          <label class="form-label font-weight-bold">Category</label>
                          <input type="text" class="form-control bg-light" value="<%= b.category %>" disabled>
                        </div>
                        <div class="mb-3">
                          <label class="form-label font-weight-bold">New Monthly Limit (Rs)</label>
                          <input type="number" name="monthlyLimit" class="form-control" value="<%= b.monthlyLimit %>" min="1" required>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-3 px-4">Update Limit</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>

            <% }) %>
          </div>
        <% } else { %>
          <p class="text-muted small mb-0">No monthly budgets set yet. Click "+ Set Budget" to set category limits.</p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Modal for Setting New Budget -->
  <div class="modal fade" id="setBudgetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
        <form action="/budget/set" method="POST">
          <div class="modal-header">
            <h5 class="modal-title fw-bold">Set Category Budget</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label font-weight-bold">Category</label>
              <select name="category" class="form-select category-select" onchange="toggleCustomCategoryInput(this)" required>
                <option value="Food">Food</option>
                <option value="Shopping">Shopping</option>
                <option value="Transport">Transport</option>
                <option value="Bills">Bills</option>
                <option value="Entertainment">Entertainment</option>
                <option value="Lifestyle">Lifestyle</option>
                <option value="Investment">Investment</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <!-- Dynamic Field for Custom Category (Budget Modal) -->
            <div class="mb-3 custom-category-field d-none">
              <label class="form-label font-weight-bold">Custom Category Name</label>
              <input type="text" name="customCategory" class="form-control" placeholder="e.g. Healthcare, Subscriptions...">
            </div>

            <div class="mb-3">
              <label class="form-label font-weight-bold">Monthly Limit (Rs)</label>
              <input type="number" name="monthlyLimit" class="form-control" placeholder="e.g. 15000" min="1" required>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary rounded-3">Save Budget</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- FILTER & SEARCH BAR SECTION -->
  <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 20px; background-color: #ffffff;">
    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-funnel me-2"></i> Filter Transactions</h6>
    <form action="/dashboard" method="GET" class="row g-3 align-items-end">
      
      <!-- Search Input -->
      <div class="col-lg-3 col-md-6">
        <label class="form-label fw-semibold text-secondary small">Search Title</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
          <input type="text" name="search" class="form-control bg-light border-start-0" placeholder="e.g. Salary, Rent..." value="<%= query && query.search ? query.search : '' %>">
        </div>
      </div>

      <!-- Category Dropdown -->
      <div class="col-lg-3 col-md-6">
        <label class="form-label fw-semibold text-secondary small">Category</label>
        <select name="category" class="form-select bg-light">
          <option value="all">All Categories</option>
          <option value="Food" <%= query && query.category === 'Food' ? 'selected' : '' %>>Food & Dining</option>
          <option value="Transport" <%= query && query.category === 'Transport' ? 'selected' : '' %>>Transport</option>
          <option value="Bills" <%= query && query.category === 'Bills' ? 'selected' : '' %>>Bills & Utilities</option>
          <option value="Entertainment" <%= query && query.category === 'Entertainment' ? 'selected' : '' %>>Entertainment</option>
          <option value="Salary" <%= query && query.category === 'Salary' ? 'selected' : '' %>>Salary</option>
          <option value="Pocket Money" <%= query && query.category === 'Pocket Money' ? 'selected' : '' %>>Pocket Money</option>
          <option value="Lifestyle" <%= query && query.category === 'Lifestyle' ? 'selected' : '' %>>Lifestyle</option>
          <option value="Investment" <%= query && query.category === 'Investment' ? 'selected' : '' %>>Investment</option>
          <option value="Business" <%= query && query.category === 'Business' ? 'selected' : '' %>>Business</option>
          <option value="Profit" <%= query && query.category === 'Profit' ? 'selected' : '' %>>Profit</option>
          <option value="Funding" <%= query && query.category === 'Funding' ? 'selected' : '' %>>Funding</option>
          <option value="Remittance" <%= query && query.category === 'Remittance' ? 'selected' : '' %>>Remittance</option>
          <option value="Other" <%= query && query.category === 'Other' ? 'selected' : '' %>>Other</option>
        </select>
      </div>

      <!-- From Date -->
      <div class="col-lg-2 col-md-6">
        <label class="form-label fw-semibold text-secondary small">From Date</label>
        <input type="date" name="startDate" class="form-control bg-light" value="<%= query && query.startDate ? query.startDate : '' %>">
      </div>

      <!-- To Date -->
      <div class="col-lg-2 col-md-6">
        <label class="form-label fw-semibold text-secondary small">To Date</label>
        <input type="date" name="endDate" class="form-control bg-light" value="<%= query && query.endDate ? query.endDate : '' %>">
      </div>

      <!-- Buttons -->
      <div class="col-lg-2 col-md-12 d-flex gap-2">
        <button type="submit" class="btn btn-success fw-semibold w-100 py-2" style="border-radius: 10px; background-color: #10b981; border: none;">Apply</button>
        <a href="/dashboard" class="btn btn-light border fw-semibold text-muted py-2" style="border-radius: 10px;" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
      </div>

    </form>
  </div>

  <!-- TRANSACTIONS TABLE SECTION -->
  <div class="card border-0 shadow-sm" style="border-radius: 20px; background-color: #ffffff; overflow: hidden;">
    <div class="card-header bg-white py-3 px-4 border-bottom-0 d-flex justify-content-between align-items-center">
      <h5 class="fw-bold text-dark mb-0">Recent Activity</h5>
      <span class="badge bg-light text-dark fw-normal border px-3 py-2">Page <%= currentPage %> of <%= totalPages || 1 %></span>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light text-secondary small text-uppercase">
          <tr>
            <th class="ps-4">Title</th>
            <th>Category</th>
            <th>Date</th>
            <th>Amount</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (expenses && expenses.length > 0) { %>
            <% expenses.forEach(exp => { %>
              <% 
                const isIncome = exp.type === 'Income' || ['Salary', 'Pocket Money'].includes(exp.category);
              %>
              <tr>
                <td class="ps-4">
                  <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-2 d-flex align-items-center justify-content-center <%= isIncome ? 'bg-success bg-opacity-10 text-success' : 'bg-danger bg-opacity-10 text-danger' %>" style="width: 38px; height: 38px;">
                      <i class="bi <%= isIncome ? 'bi-arrow-down-left' : 'bi-arrow-up-right' %> fw-bold"></i>
                    </div>
                    <span class="fw-semibold text-dark"><%= exp.title %></span>
                  </div>
                </td>
                <td>
                  <span class="badge bg-light text-dark border px-3 py-1 fw-medium" style="border-radius: 8px;"><%= exp.category %></span>
                </td>
                <td class="text-muted small">
                  <%= new Date(exp.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </td>
                <td class="fw-bold <%= isIncome ? 'text-success' : 'text-danger' %>">
                  <%= isIncome ? '+' : '-' %> Rs. <%= exp.amount.toLocaleString() %>
                </td>

                <td class="text-center align-middle">
                  <div class="d-flex justify-content-center gap-2">
                    
                    <!-- EDIT BUTTON (Triggers Modal) -->
                    <button type="button" 
                            class="btn btn-sm btn-outline-primary border-0 rounded-circle p-2"
                            data-bs-toggle="modal" 
                            data-bs-target="#editModal-<%= exp._id %>" 
                            title="Edit">
                      <i class="bi bi-pencil-square fs-6"></i>
                    </button>

                    <!-- DELETE FORM -->
                    <form action="/expense/delete/<%= exp._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this transaction?');">
                      <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-2" title="Delete">
                        <i class="bi bi-trash fs-6"></i>
                      </button>
                    </form>

                  </div>

                  <!-- EDIT MODAL -->
                  <div class="modal fade text-start" id="editModal-<%= exp._id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                        <div class="modal-header border-0 pb-0">
                          <h5 class="modal-title fw-bold">Edit Transaction</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form action="/expense/edit/<%= exp._id %>" method="POST">
                          <div class="modal-body p-4">
                            <div class="mb-3">
                              <label class="form-label fw-semibold">Title</label>
                              <input type="text" name="title" class="form-control rounded-3" value="<%= exp.title %>" required>
                            </div>
                            
                            <div class="row">
                              <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Amount (Rs.)</label>
                                <input type="number" name="amount" class="form-control rounded-3" value="<%= exp.amount %>" required>
                              </div>
                              <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Type</label>
                                <select name="type" class="form-select rounded-3" required>
                                  <option value="Expense" <%= exp.type === 'Expense' ? 'selected' : '' %>>Expense</option>
                                  <option value="Income" <%= exp.type === 'Income' ? 'selected' : '' %>>Income</option>
                                </select>
                              </div>
                            </div>

                            <div class="row">
                              <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Category</label>
                                <select name="category" class="form-select rounded-3 category-select" onchange="toggleCustomCategoryInput(this)" required>
                                  <option value="Food" <%= exp.category === 'Food' ? 'selected' : '' %>>Food</option>
                                  <option value="Transport" <%= exp.category === 'Transport' ? 'selected' : '' %>>Transport</option>
                                  <option value="Bills" <%= exp.category === 'Bills' ? 'selected' : '' %>>Bills</option>
                                  <option value="Entertainment" <%= exp.category === 'Entertainment' ? 'selected' : '' %>>Entertainment</option>
                                  <option value="Salary" <%= exp.category === 'Salary' ? 'selected' : '' %>>Salary</option>
                                  <option value="Other" <%= !['Food','Transport','Bills','Entertainment','Salary'].includes(exp.category) ? 'selected' : '' %>>Other</option>
                                </select>
                              </div>
                              <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Date</label>
                                <input type="date" name="date" class="form-control rounded-3" value="<%= new Date(exp.date).toISOString().split('T')[0] %>" required>
                              </div>
                            </div>

                            <!-- Dynamic Field for Edit Transaction Custom Category -->
                            <div class="mb-3 custom-category-field <%= !['Food','Transport','Bills','Entertainment','Salary'].includes(exp.category) ? '' : 'd-none' %>">
                              <label class="form-label fw-semibold">Custom Category Name</label>
                              <input type="text" name="customCategory" class="form-control rounded-3" value="<%= exp.category %>" placeholder="e.g. Healthcare, Pet Care">
                            </div>

                          </div>
                          <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success rounded-3 px-4" style="background-color: #10b981; border: none;">Save Changes</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i>
                No records found. Click <strong>Add Transaction</strong> to start!
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination Controls -->
    <% if (totalPages > 1) { %>
      <div class="card-footer bg-white border-0 py-3">
        <nav>
          <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
              <a class="page-link" href="/dashboard?page=<%= currentPage - 1 %>&search=<%= query.search || '' %>&category=<%= query.category || '' %>&startDate=<%= query.startDate || '' %>&endDate=<%= query.endDate || '' %>">Previous</a>
            </li>

            <% for(let i = 1; i <= totalPages; i++) { %>
              <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                <a class="page-link <%= currentPage === i ? 'bg-success border-success' : '' %>" href="/dashboard?page=<%= i %>&search=<%= query.search || '' %>&category=<%= query.category || '' %>&startDate=<%= query.startDate || '' %>&endDate=<%= query.endDate || '' %>"><%= i %></a>
              </li>
            <% } %>

            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
              <a class="page-link" href="/dashboard?page=<%= currentPage + 1 %>&search=<%= query.search || '' %>&category=<%= query.category || '' %>&startDate=<%= query.startDate || '' %>&endDate=<%= query.endDate || '' %>">Next</a>
            </li>
          </ul>
        </nav>
      </div>
    <% } %>

  </div>

</div>

<!-- ADD TRANSACTION POPUP MODAL -->
<div class="modal fade" id="addTransactionModal" tabindex="-1" aria-labelledby="addTransactionModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
      
      <div class="modal-header border-bottom-0 pt-4 px-4 pb-0">
        <h5 class="modal-title fw-bold text-dark" id="addTransactionModalLabel">Add New Transaction</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4">
        <form action="/add-expense" method="POST">
          
          <div class="mb-3">
            <label class="form-label fw-semibold text-secondary small">Transaction Type</label>
            <select name="type" class="form-select bg-light" required>
              <option value="Expense">Expense</option>
              <option value="Income">Income</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold text-secondary small">Title</label>
            <input type="text" name="title" class="form-control bg-light" placeholder="e.g. Lunch, Salary, Groceries" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold text-secondary small">Amount (Rs.)</label>
            <input type="number" name="amount" class="form-control bg-light" placeholder="e.g. 1500" min="0" step="any" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold text-secondary small">Category</label>
            <select name="category" class="form-select bg-light category-select" onchange="toggleCustomCategoryInput(this)" required>
              <option value="Food">Food & Dining</option>
              <option value="Transport">Transport</option>
              <option value="Bills">Bills & Utilities</option>
              <option value="Entertainment">Entertainment</option>
              <option value="Salary">Salary</option>
              <option value="Pocket Money">Pocket Money</option>
              <option value="Lifestyle">Lifestyle</option>
              <option value="Investment">Investment</option>
              <option value="Business">Business</option>
              <option value="Profit">Profit</option>
              <option value="Funding">Funding</option>
              <option value="Remittance">Remittance</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <!-- Dynamic Field for Add Transaction Custom Category -->
          <div class="mb-4 custom-category-field d-none">
            <label class="form-label fw-semibold text-secondary small">Custom Category Name</label>
            <input type="text" name="customCategory" class="form-control bg-light" placeholder="e.g. Healthcare, Subscriptions">
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success fw-semibold w-100 py-2" style="border-radius: 10px; background-color: #10b981; border: none;">Save Transaction</button>
            <button type="button" class="btn btn-light border fw-semibold w-100 py-2" data-bs-dismiss="modal" style="border-radius: 10px;">Cancel</button>
          </div>

        </form>
      </div>

    </div>
  </div>
</div>


<!-- SCRIPT FOR RENDER GRAPH CHARTS & DYNAMIC INPUTS -->
<script>
  // Function to show/hide custom category input dynamically
  function toggleCustomCategoryInput(selectElement) {
    const form = selectElement.closest('form');
    const customField = form.querySelector('.custom-category-field');
    const customInput = customField ? customField.querySelector('input') : null;

    if (selectElement.value === 'Other') {
      if (customField) customField.classList.remove('d-none');
      if (customInput) customInput.setAttribute('required', 'required');
    } else {
      if (customField) customField.classList.add('d-none');
      if (customInput) {
        customInput.removeAttribute('required');
        customInput.value = '';
      }
    }
  }

  document.addEventListener("DOMContentLoaded", function () {
    const rawData = '<%- categoryChartData %>';
    let rawCategoryData = {};
    
    try {
      rawCategoryData = JSON.parse(rawData);
    } catch (e) {
      console.log("Chart parsing error:", e);
    }
    
    const labels = Object.keys(rawCategoryData);
    const dataValues = Object.values(rawCategoryData);

    // Standard static categories map
    const categoryColorMap = {
      'Food': '#f97316',          // Vibrant Orange
      'Transport': '#6366f1',     // Indigo
      'Bills': '#ef4444',         // Red
      'Entertainment': '#10b981', // Green
      'Shopping': '#f59e0b',      // Amber
      'Lifestyle': '#8b5cf6',     // Purple
      'Investment': '#ec4899',    // Pink
      'Other': '#3b82f6'          // Blue
    };

    // Unique Color Generator 
    function getCategoryColors(categories) {
      return categories.map((cat, index) => {
        if (categoryColorMap[cat]) {
          return categoryColorMap[cat];
        }
        // Unique Golden Ratio Hue Generator for endless 100% distinct colors
        const hue = (index * 137.508) % 360; 
        return `hsl(${hue}, 75%, 50%)`;
      });
    }

    const chartColors = getCategoryColors(labels);

    // 1. Category Doughnut Chart
    const ctx1 = document.getElementById('categoryChart');
    if (ctx1) {
      new Chart(ctx1.getContext('2d'), {
        type: 'doughnut',
        data: {
          labels: labels.length > 0 ? labels : ['No Expenses Yet'],
          datasets: [{
            data: dataValues.length > 0 ? dataValues : [1],
            backgroundColor: dataValues.length > 0 ? chartColors : ['#cbd5e1'],
            borderWidth: 2,
            borderColor: '#ffffff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' }
          }
        }
      });
    }

    // 2. Bar Chart: Income vs Expense Comparison
    const ctx2 = document.getElementById('ratioChart');
    if (ctx2) {
      new Chart(ctx2.getContext('2d'), {
        type: 'bar',
        data: {
          labels: ['Income', 'Expenses'],
          datasets: [{
            label: 'Amount (Rs.)',
            data: [Number('<%= totalIncome %>') || 0, Number('<%= totalExpense %>') || 0],
            backgroundColor: ['#10b981', '#ef4444'],
            borderRadius: 8
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: { beginAtZero: true }
          }
        }
      });
    }
  });
</script>

<%- include('partials/footer') %>