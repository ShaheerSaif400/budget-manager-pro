<%- include('partials/header') %>

<!-- Top Status Cards (Income, Expense, Balance) -->
<% 
  let totalIncome = 0;
  let totalExpense = 0;
  expenses.forEach(t => {
    if(t.type === 'Income') totalIncome += t.amount;
    else totalExpense += t.amount;
  });
  let netBalance = totalIncome - totalExpense;
%>
<div class="row mb-4 text-center">
  <div class="col-md-4 mb-2">
    <div class="card bg-success text-white shadow-sm p-3">
      <h6>Total Income (Filtered)</h6>
      <h3 class="fw-bold">Rs. <%= totalIncome %></h3>
    </div>
  </div>
  <div class="col-md-4 mb-2">
    <div class="card bg-danger text-white shadow-sm p-3">
      <h6>Total Expenses (Filtered)</h6>
      <h3 class="fw-bold">Rs. <%= totalExpense %></h3>
    </div>
  </div>
  <div class="col-md-4 mb-2">
    <div class="card <%= netBalance >= 0 ? 'bg-primary' : 'bg-warning text-dark' %> text-white shadow-sm p-3">
      <h6>Net Balance</h6>
      <h3 class="fw-bold">Rs. <%= netBalance %></h3>
    </div>
  </div>
</div>

<!-- Search & Filter Bar -->
<div class="card shadow-sm border-0 mb-4 bg-light">
  <div class="card-body p-3">
    <form action="/dashboard" method="GET" class="row g-2 align-items-end">
      
      <!-- Search Input -->
      <div class="col-md-3">
        <label class="form-label small fw-semibold text-muted mb-1">Search</label>
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
          <input type="text" name="search" class="form-control" placeholder="Search title..." value="<%= (typeof query !== 'undefined' && query.search) ? query.search : '' %>">
        </div>
      </div>

      <!-- Category Dropdown -->
      <div class="col-md-3">
        <label class="form-label small fw-semibold text-muted mb-1">Category</label>
        <select name="category" class="form-select form-select-sm">
          <option value="all">All Categories</option>
          <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= (typeof query !== 'undefined' && query.category === cat) ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <!-- Start Date -->
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-muted mb-1">From Date</label>
        <input type="date" name="startDate" class="form-control form-control-sm" value="<%= (typeof query !== 'undefined' && query.startDate) ? query.startDate : '' %>">
      </div>

      <!-- End Date -->
      <div class="col-md-2">
        <label class="form-label small fw-semibold text-muted mb-1">To Date</label>
        <input type="date" name="endDate" class="form-control form-control-sm" value="<%= (typeof query !== 'undefined' && query.endDate) ? query.endDate : '' %>">
      </div>

      <!-- Submit & Reset -->
      <div class="col-md-2 d-flex gap-1">
        <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-funnel-fill"></i> Filter</button>
        <a href="/dashboard" class="btn btn-outline-secondary btn-sm w-100">Reset</a>
      </div>

    </form>
  </div>
</div>

<div class="row">
  <!-- Left Column: Add Transaction Form -->
  <div class="col-md-5 mb-4">
    <div class="card shadow-sm p-4">
      <h4 class="fw-bold mb-3 text-secondary"><i class="bi bi-plus-circle-fill text-primary me-2"></i>Add New Transaction</h4>
      <form action="/add-expense" method="POST">
        
        <!-- Transaction Type -->
        <div class="mb-3">
          <label class="form-label small fw-bold">Transaction Type</label>
          <select name="type" id="transactionType" class="form-select" required>
            <option value="Expense" selected>Expense</option>
            <option value="Income">Income</option>
          </select>
        </div>

        <!-- Title / Description -->
        <div class="mb-3">
          <input type="text" name="title" class="form-control" placeholder="Description (e.g., Salary, Biryani)" required>
        </div>

        <!-- Amount -->
        <div class="mb-3">
          <input type="number" name="amount" class="form-control" placeholder="Amount (PKR)" required>
        </div>

        <!-- Dynamic Category Dropdown -->
        <div class="mb-3">
          <label class="form-label small fw-bold">Category</label>
          <select name="category" id="transactionCategory" class="form-select" required>
            <option value="" disabled selected>Select Category</option>
            
            <!-- Expense Options -->
            <option class="expense-opt" value="Food">Food</option>
            <option class="expense-opt" value="Rent">Rent</option>
            <option class="expense-opt" value="Entertainment">Entertainment</option>
            <option class="expense-opt" value="Bills">Bills</option>
            <option class="expense-opt" value="Shopping">Shopping</option>
            <option class="expense-opt" value="Medical">Medical</option>
            <option class="expense-opt" value="Travel">Travel</option>
            <option class="expense-opt" value="Other">Other</option>

            <!-- Income Options -->
            <option class="income-opt" value="Salary">Salary</option>
            <option class="income-opt" value="Freelancing">Freelancing</option>
            <option class="income-opt" value="Pocket Money">Pocket Money</option>
            <option class="income-opt" value="Investments">Investments</option>
            <option class="income-opt" value="Grants/Gifts">Grants/Gifts</option>
          </select>
        </div>

        <button type="submit" class="btn btn-dark w-100">Submit</button>
      </form>
    </div>
  </div>

  <!-- Right Column: History List -->
  <div class="col-md-7">
    <div class="card shadow-sm p-4">
      <h4 class="mb-3 text-secondary">Transaction History</h4>
      <ul class="list-group mb-3">
        <% if (expenses.length === 0) { %>
          <li class="list-group-item text-center text-muted py-4">No transactions found matching your criteria.</li>
        <% } else { %>
          <% expenses.forEach(t => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <div>
                <h6 class="my-0"><%= t.title %></h6>
                <span class="badge bg-secondary rounded-pill small"><%= t.category %></span>
                <span class="badge <%= t.type === 'Income' ? 'bg-success' : 'bg-danger' %> rounded-pill small"><%= t.type %></span>
              </div>
              <span class="<%= t.type === 'Income' ? 'text-success' : 'text-danger' %> fw-bold">
                <%= t.type === 'Income' ? '+' : '-' %> Rs. <%= t.amount %>
              </span>
            </li>
          <% }) %>
        <% } %>
      </ul>

      <!-- Pagination Controls -->
      <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
        <nav class="d-flex justify-content-center mt-2">
          <ul class="pagination pagination-sm mb-0">
            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
              <a class="page-link" href="/dashboard?page=<%= currentPage - 1 %>&search=<%= (typeof query !== 'undefined' && query.search) || '' %>&category=<%= (typeof query !== 'undefined' && query.category) || '' %>&startDate=<%= (typeof query !== 'undefined' && query.startDate) || '' %>&endDate=<%= (typeof query !== 'undefined' && query.endDate) || '' %>">Previous</a>
            </li>
            <% for(let i = 1; i <= totalPages; i++) { %>
              <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                <a class="page-link" href="/dashboard?page=<%= i %>&search=<%= (typeof query !== 'undefined' && query.search) || '' %>&category=<%= (typeof query !== 'undefined' && query.category) || '' %>&startDate=<%= (typeof query !== 'undefined' && query.startDate) || '' %>&endDate=<%= (typeof query !== 'undefined' && query.endDate) || '' %>"><%= i %></a>
              </li>
            <% } %>
            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
              <a class="page-link" href="/dashboard?page=<%= currentPage + 1 %>&search=<%= (typeof query !== 'undefined' && query.search) || '' %>&category=<%= (typeof query !== 'undefined' && query.category) || '' %>&startDate=<%= (typeof query !== 'undefined' && query.startDate) || '' %>&endDate=<%= (typeof query !== 'undefined' && query.endDate) || '' %>">Next</a>
            </li>
          </ul>
        </nav>
      <% } %>

    </div>
  </div>
</div>

<script>
  const typeSelect = document.getElementById('transactionType');
  const categorySelect = document.getElementById('transactionCategory');

  function updateCategories() {
    const selectedType = typeSelect.value;
    const incomeOptions = document.querySelectorAll('.income-opt');
    const expenseOptions = document.querySelectorAll('.expense-opt');

    categorySelect.value = "";

    if (selectedType === 'Income') {
      incomeOptions.forEach(opt => opt.style.display = 'block');
      expenseOptions.forEach(opt => opt.style.display = 'none');
    } else {
      incomeOptions.forEach(opt => opt.style.display = 'none');
      expenseOptions.forEach(opt => opt.style.display = 'block');
    }
  }

  typeSelect.addEventListener('change', updateCategories);
  document.addEventListener('DOMContentLoaded', updateCategories);
</script>

<%- include('partials/footer') %>