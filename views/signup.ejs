<%- include('partials/header') %>

<div class="row justify-content-center align-items-center my-5">
  <div class="col-md-6 col-lg-5">
    <div class="card border-0 shadow-lg p-4" style="border-radius: 20px; background-color: #ffffff;">
      
      <!-- Header -->
      <div class="text-center mb-4">
        <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex p-3 text-success mb-2">
          <i class="bi bi-person-plus fs-2"></i>
        </div>
        <h3 class="fw-bold text-dark mb-1">Create Account</h3>
        <p class="text-muted small">Start managing your personal finances effectively</p>
      </div>

      <!-- Signup Form -->
      <form action="/signup" method="POST" enctype="multipart/form-data">
        
        <div class="mb-3">
          <label class="form-label fw-semibold small text-secondary">Full Name</label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
            <input type="text" name="name" class="form-control bg-light border-start-0" placeholder="John Doe" required>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold small text-secondary">Email Address</label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
            <input type="email" name="email" class="form-control bg-light border-start-0" placeholder="name@example.com" required>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold small text-secondary">Password</label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
            <input type="password" name="password" class="form-control bg-light border-start-0" placeholder="••••••••" required>
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label fw-semibold small text-secondary">Profile Picture (Optional)</label>
          <input type="file" name="avatar" class="form-control bg-light">
        </div>

        <button type="submit" class="btn btn-success fw-bold w-100 py-2 mb-3" style="border-radius: 12px; background-color: #10b981; border: none;">
          Register Now
        </button>
      </form>

      <div class="text-center mt-2">
        <p class="text-muted small mb-0">Already registered? <a href="/login" class="text-success fw-semibold text-decoration-none">Sign In</a></p>
      </div>

    </div>
  </div>
</div>

<%- include('partials/footer') %>