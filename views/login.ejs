<%- include('./partials/header') %>

<div class="row justify-content-center mt-5">
  <div class="col-md-5 col-lg-4">
    <div class="card shadow-sm border-0 rounded-3">
      <div class="card-body p-4">
        
        <!-- Header with Professional Bootstrap Icon -->
        <div class="text-center mb-4">
          <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
            <i class="bi bi-person-lock fs-3"></i>
          </div>
          <h4 class="fw-bold text-dark mb-1">Welcome Back</h4>
          <p class="text-muted small">Sign in to manage your budget</p>
        </div>

        <!-- Flash / Error Messages -->
        <% if (locals.error && error.length > 0) { %>
          <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center small" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-6"></i>
            <div><%= error %></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>

        <form action="/login" method="POST">
          <!-- Email Input -->
          <div class="mb-3">
            <label for="email" class="form-label small fw-semibold text-secondary">Email Address</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
              <input type="email" class="form-control border-start-0 bg-light" id="email" name="email" placeholder="name@example.com" required>
            </div>
          </div>

          <!-- Password Input -->
          <div class="mb-4">
            <label for="password" class="form-label small fw-semibold text-secondary">Password</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
              <input type="password" class="form-control border-start-0 bg-light" id="password" name="password" placeholder="••••••••" required>
            </div>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mb-3">
            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
          </button>
        </form>

        <!-- Footer Link -->
        <div class="text-center border-top pt-3">
          <p class="small text-muted mb-0">Don't have an account? 
            <a href="/register" class="text-primary text-decoration-none fw-semibold">Create Account</a>
          </p>
        </div>

      </div>
    </div>
  </div>
</div>

<%- include('./partials/footer') %>