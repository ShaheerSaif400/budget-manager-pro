<%- include('partials/header') %>

<div class="row justify-content-center align-items-center my-5">
  <div class="col-md-5 col-lg-4">
    <div class="card border-0 shadow-lg p-4" style="border-radius: 20px; background-color: #ffffff;">
      
      <!-- Logo & Header -->
      <div class="text-center mb-4">
        <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex p-3 text-success mb-2">
          <i class="bi bi-wallet2 fs-2"></i>
        </div>
        <h3 class="fw-bold text-dark mb-1">Welcome Back</h3>
        <p class="text-muted small">Enter your credentials to access your dashboard</p>
      </div>

      <!-- Flash / Error Message -->
<% if (error_msg && error_msg.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <%= error_msg %>
    <button type="type" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (success_msg && success_msg.length > 0) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= success_msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
      <!-- Login Form -->
      <form action="/login" method="POST">
        <div class="mb-3">
          <label class="form-label fw-semibold small text-secondary">Email Address</label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
            <input type="email" name="email" class="form-control bg-light border-start-0" placeholder="name@example.com" required>
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label fw-semibold small text-secondary">Password</label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
            <input type="password" name="password" class="form-control bg-light border-start-0" placeholder="••••••••" required>
          </div>
        </div>

        <button type="submit" class="btn btn-success fw-bold w-100 py-2 mb-3" style="border-radius: 12px; background-color: #10b981; border: none;">
          Sign In
        </button>
      </form>

      <div class="text-center mt-2">
        <p class="text-muted small mb-0">Don't have an account? <a href="/signup" class="text-success fw-semibold text-decoration-none">Create One</a></p>
      </div>

    </div>
  </div>
</div>

<%- include('partials/footer') %>